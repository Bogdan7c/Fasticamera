#version 450
// Тестовые подложки (только feature test-support): заполняют storage-картинку RGBA16F узором.
// Режимы: 0 — сетка координат (R = B = (x+0.5)/ширина, G = (y+0.5)/высота: два канала несут X, чтобы дисперсия R/B была видна), 1 — сплошной цвет,
// 2 — «фото» (градиент + шахматка + цветные полосы, детерминированно).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D target_image;

layout(push_constant) uniform FillParams {
    uint width;
    uint height;
    uint mode;
    uint reserved;
    vec4 color;
} fill;

vec3 photo(vec2 uv, vec2 pixel) {
    // Фон: диагональный градиент от тёмно-синего к тёплому.
    vec3 base = mix(vec3(0.05, 0.10, 0.28), vec3(0.95, 0.62, 0.30), clamp(0.5 * (uv.x + uv.y), 0.0, 1.0));
    // Шахматка в левой трети: клетки 24 px, чередуют светлое и тёмное.
    if (uv.x < 0.33 && uv.y > 0.35) {
        float cell = mod(floor(pixel.x / 24.0) + floor(pixel.y / 24.0), 2.0);
        base = mix(vec3(0.15), vec3(0.85), cell);
    }
    // Цветные полосы внизу: красная, зелёная, синяя, белая, чёрная.
    if (uv.y > 0.82) {
        float band = floor(uv.x * 5.0);
        if (band < 1.0) base = vec3(0.9, 0.1, 0.1);
        else if (band < 2.0) base = vec3(0.1, 0.8, 0.2);
        else if (band < 3.0) base = vec3(0.1, 0.2, 0.9);
        else if (band < 4.0) base = vec3(1.0);
        else base = vec3(0.0);
    }
    return base;
}

void main() {
    uvec2 position = gl_GlobalInvocationID.xy;
    if (position.x >= fill.width || position.y >= fill.height) {
        return;
    }
    vec2 size = vec2(fill.width, fill.height);
    vec2 pixel = vec2(position) + 0.5;
    vec2 uv = pixel / size;
    vec3 rgb;
    if (fill.mode == 0u) {
        rgb = vec3(uv.x, uv.y, uv.x);
    } else if (fill.mode == 1u) {
        rgb = fill.color.rgb;
    } else {
        rgb = photo(uv, pixel);
    }
    imageStore(target_image, ivec2(position), vec4(rgb, 1.0));
}
