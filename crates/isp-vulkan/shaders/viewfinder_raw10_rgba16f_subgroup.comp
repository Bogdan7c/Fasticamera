#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Вариант с быстрым путём статистики AWB через subgroupAdd (только если устройство поддерживает
// арифметику subgroup в compute; иначе Rust берёт вариант без суффикса `_subgroup`).
#define AWB_SUBGROUP_REDUCTION
// ISP видоискателя: вход RAW10, выход — storage-картинка формата rgba16f (см. viewfinder_isp.glsl).
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D viewfinder_image;
#include "viewfinder_isp.glsl"
#include "viewfinder_source_raw10.glsl"
