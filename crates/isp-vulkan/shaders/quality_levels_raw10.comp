#version 450
#extension GL_GOOGLE_include_directive : require
// Проход 0 для RAW10: кадр — упакованный буфер, 4 пикселя в 5 байтах, читается словами.
// Пиксель i (0..3) группы = (byte_i << 2) | ((byte_4 >> (2*i)) & 3) — формат Android RAW10.

#define FRAME_PARAMS_BINDING 1
#include "quality_frame_params.glsl"

layout(set = 0, binding = 0, std430) readonly buffer PackedFrame {
    uint words[];
} packed_frame;

// Один байт буфера (little-endian внутри слова).
uint byte_at(uint byte_offset) {
    return (packed_frame.words[byte_offset >> 2u] >> ((byte_offset & 3u) * 8u)) & 0xFFu;
}

uint raw_at(uint frame_x, uint frame_y) {
    uint group_offset = frame_y * frame.source_area.z + (frame_x >> 2u) * 5u;
    uint index_in_group = frame_x & 3u;
    uint high_bits = byte_at(group_offset + index_in_group) << 2u;
    uint low_bits = (byte_at(group_offset + 4u) >> (2u * index_in_group)) & 3u;
    return high_bits | low_bits;
}

#include "quality_levels_main.glsl"
