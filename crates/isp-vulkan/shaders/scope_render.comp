#version 450
// Правило показа цветовых приборов: счётчики -> картинка прибора RGBA16F, ПРЯМАЯ альфа, цвета экрана.
// CPU-эталон: `scope_model::render` (функции `render`, `graticule_alpha`, `composite_over`), `scope_model::trace_painter`
// (пиксельные формулы трёх способов рисования следа), `scope_model::TraceReference` (яркость следа по счётчику)
// и `scope_model::graticule` (покрытие примитивов). Три способа следа (`PAINT_*`): секции по плоскостям (RGB parade),
// плоскости наложением (RGB waveform), цвет по положению (вектороскоп). Способ называет правило прибора, а не вид:
// в шейдер он приходит словом `trace.w`. Целочисленное отображение «пиксель -> ячейка» совпадает
// с эталоном точно; log2, sqrt и деление дают расхождение в пределах квантования fp16 (см. тесты).
// Размер группы — specialization-константы 0 и 1 (см. `scope_accumulate_common.glsl`).
layout(local_size_x_id = 0, local_size_y_id = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D picture;

// Примитив сетки: geometry — отрезок (from, to), кольцо (центр, радиусы) или рамка (центр, половины сторон);
// style.x — полуширина линии в пикселях, style.y — вид (0 отрезок, 1 кольцо, 2 рамка).
struct GraticulePrimitive {
    vec4 geometry;
    vec4 style;
};

layout(set = 0, binding = 1, std430) readonly buffer RenderParameters {
    uvec4 grid;             // столбцы, строки, плоскости, число примитивов
    vec4 trace;             // x = готовый знаменатель яркости log2(1 + порог): считает scope-model (`TraceReference`)
                            //     по доле отсчётов столбца или кадра и числу отсчётов окна, шейдер порог не знает;
                            // y = непрозрачность следа, z = непрозрачность сетки,
                            // w = способ рисования следа (PAINT_*, код по `parameter_blocks.rs`)
    vec4 graticule_color;   // rgb
    vec4 plane_colors[3];   // rgb следа по плоскостям (секции) или основные цвета наложения
    GraticulePrimitive primitives[48];
    // ХВОСТ «цвет по положению» (способ PAINT_COLOR_BY_POSITION; у остальных способов — нули и не читается).
    vec4 position_palette[128]; // rgb края и радиус края (клеток) по углам круга
    vec4 position_neutral;      // rgb центра
    vec4 position_geometry;     // x = центр (клеток), y = радиус «это центр», z = наименьший радиус края
    // ТАБЛИЦА МАСШТАБОВ СЧЁТЧИКА ПО СТОЛБЦАМ (секции и наложение): `среднее отсчётов на столбец / отсчётов столбца`,
    // готовые f32 от scope-model (`ColumnCountScales`; 0.0 у столбца без отсчётов, 1.0 везде у вектороскопа).
    // Отсчёты по столбцам делятся неравномерно (шаг 2 на 768 отсчётов в 512 столбцов: у одних столбцов один отсчёт по
    // горизонтали, у других два), и без масштаба «двойные» столбцы горят ярче (вертикальные полосы). Читаются первые
    // `grid.x` записей; последняя часть блока.
    float column_scales[4096];
} parameters;

layout(set = 0, binding = 2, std430) readonly buffer ScopeCounters {
    uint counts[];
} counters;

const float KIND_SEGMENT = 0.0;
const float KIND_RING = 1.0;

// Способы рисования следа (parameters.trace.w); те же числа, что `PAINT_CODE_*` в `parameter_blocks.rs`.
const float PAINT_PLANE_SECTIONS = 0.0;
const float PAINT_PLANES_OVERLAID = 1.0;
const float PAINT_COLOR_BY_POSITION = 2.0;
const uint POSITION_PALETTE_ANGLES = 128u;
const float TAU = 6.28318530717958647692;

// Яркость следа по счётчику: лог-шкала `min(1, log2(1 + count * scale) / trace.x)`, одна для всех трёх способов
// (эталон — `TraceReference::intensity_scaled`, ТОТ ЖЕ порядок операций f32: `count * scale`, `1 + …`, `log2`,
// деление, `min`). `scale` — масштаб счётчика столбца (1.0 даёт прежнюю формулу бит в бит). Полная яркость
// достигается при `count * scale`, равном порогу из `trace.x`.
float trace_intensity(uint count, float scale) {
    return count == 0u ? 0.0 : min(log2(1.0 + float(count) * scale) / parameters.trace.x, 1.0);
}

// Цвет ячейки `(column, row)` вектороскопа по её положению: эталон — `PositionPalette::colour_at`.
// Центральная клетка даёт d = (0, 0), а atan(0, 0) в GLSL не определён (на Adreno может быть NaN), поэтому
// ветка «центр -> нейтраль» стоит ДО вычисления угла.
vec3 position_color(uint column, uint row) {
    float centre = parameters.position_geometry.x;
    vec2 offset = vec2(float(column) + 0.5 - centre, centre - (float(row) + 0.5));
    float radius = length(offset);
    vec3 neutral = parameters.position_neutral.rgb;
    if (!(radius > parameters.position_geometry.y)) {
        return neutral;
    }
    float turns = atan(offset.y, offset.x) / TAU;
    if (turns < 0.0) {
        turns += 1.0;
    }
    float position = turns * float(POSITION_PALETTE_ANGLES);
    float base = floor(position);
    float fraction = position - base;
    uint first = uint(base) % POSITION_PALETTE_ANGLES;
    uint second = (first + 1u) % POSITION_PALETTE_ANGLES;
    vec4 low = parameters.position_palette[first];
    vec4 high = parameters.position_palette[second];
    float edge_radius = max(mix(low.w, high.w, fraction), parameters.position_geometry.z);
    float reach = clamp(radius / edge_radius, 0.0, 1.0);
    return mix(neutral, mix(low.rgb, high.rgb, fraction), reach);
}

float distance_to_segment(vec2 point, vec2 start, vec2 end) {
    vec2 along = end - start;
    vec2 relative = point - start;
    float length_squared = dot(along, along);
    float fraction = length_squared > 0.0 ? clamp(dot(relative, along) / length_squared, 0.0, 1.0) : 0.0;
    return length(relative - along * fraction);
}

float distance_to_box_outline(vec2 point, vec2 centre, vec2 half_size) {
    vec2 excess = abs(point - centre) - half_size;
    float outside = length(max(excess, vec2(0.0)));
    float inside = min(max(excess.x, excess.y), 0.0);
    return abs(outside + inside);
}

// Расстояние от точки до примитива, пикселей (разность с полуполосой линии даёт покрытие).
float primitive_distance(GraticulePrimitive primitive, vec2 point, vec2 picture_px) {
    vec2 first = primitive.geometry.xy * picture_px;
    vec2 second = primitive.geometry.zw * picture_px;
    float distance_px;
    if (primitive.style.y == KIND_SEGMENT) {
        distance_px = distance_to_segment(point, first, second);
    } else if (primitive.style.y == KIND_RING) {
        float normalized = length((point - first) / second);
        distance_px = abs(normalized - 1.0) * min(second.x, second.y);
    } else {
        distance_px = distance_to_box_outline(point, first, second);
    }
    return distance_px;
}

// Покрытие пикселя примитивом: clamp(полуширина + 0.5 - расстояние, 0, 1).
float primitive_coverage(GraticulePrimitive primitive, vec2 point, vec2 picture_px) {
    float half_width = primitive.style.x;
    float distance_px = primitive_distance(primitive, point, picture_px);
    return clamp(half_width + 0.5 - distance_px, 0.0, 1.0);
}

// ОТБОР ПРИМИТИВОВ ПО ПЛИТКЕ (точный: картинка бит в бит прежняя). Каждая нить группы проверяет свои примитивы
// против всей плитки группы; в список попадает примитив, который может дать ненулевое покрытие хоть одному
// пикселю плитки. Расстояние до любого примитива 1-липшицево по точке (отрезок и рамка — настоящее расстояние;
// кольцо — |n - 1| * min(радиусы), где n меняется не быстрее 1 / min(радиусы)), поэтому если расстояние от
// ЦЕНТРА плитки минус радиус плитки не меньше полуширины + 0.5 (+ запас на ошибку f32), покрытие каждого пикселя
// плитки равно нулю и примитив не влияет на `max`. NaN в расстоянии даёт «оставить» (сравнение ложно).
const float CULL_SLACK_PX = 0.01;
shared uint kept_count;
shared uint kept_primitive_index[48];

void select_primitives_touching_the_tile(vec2 picture_px) {
    uint group_threads = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    if (gl_LocalInvocationIndex == 0u) {
        kept_count = 0u;
    }
    barrier();
    // Центры пикселей плитки заполняют прямоугольник от (начало + 0.5) до (конец - 0.5): его центр и полудиагональ.
    vec2 tile_size = vec2(gl_WorkGroupSize.xy);
    vec2 tile_centre = vec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy) + 0.5 * tile_size;
    float tile_radius = 0.5 * length(tile_size - vec2(1.0));
    for (uint index = gl_LocalInvocationIndex; index < parameters.grid.w; index += group_threads) {
        GraticulePrimitive primitive = parameters.primitives[index];
        float centre_distance = primitive_distance(primitive, tile_centre, picture_px);
        bool cannot_touch_tile = centre_distance - tile_radius - CULL_SLACK_PX >= primitive.style.x + 0.5;
        if (!cannot_touch_tile) {
            uint slot = atomicAdd(kept_count, 1u);
            kept_primitive_index[slot] = index;
        }
    }
    barrier();
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 size = uvec2(imageSize(picture));
    vec2 picture_px = vec2(size);
    // Отбор примитивов — на ВСЕХ нитях группы (барьеры), в том числе у пикселей за краем картинки.
    select_primitives_touching_the_tile(picture_px);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    uint columns = parameters.grid.x;
    uint rows = parameters.grid.y;
    uint planes = parameters.grid.z;
    // Пиксель -> ячейка целочисленно. Стороны <= 4096, плоскостей <= 3: произведения помещаются в uint.
    uint row = (pixel.y * rows) / size.y;
    uint plane = (pixel.x * planes) / size.x;
    uint column = ((pixel.x * planes - plane * size.x) * columns) / size.x;
    uint count = counters.counts[(plane * rows + row) * columns + column];

    float trace_alpha = 0.0;
    // Цвет следа для способов «наложение» и «по положению»; у секций цвет берётся ниже по плоскости.
    vec3 branch_trace_color = vec3(0.0);
    if (parameters.trace.w == PAINT_PLANES_OVERLAID) {
        // Все плоскости рисуются в одни пиксели на всю ширину; цвет = смесь цветов плоскостей по их яркостям,
        // делённая на свой наибольший канал; прозрачность — по самой яркой плоскости.
        uint overlay_column = (pixel.x * columns) / size.x;
        vec3 weighted = vec3(0.0);
        float brightest = 0.0;
        for (uint overlay_plane = 0u; overlay_plane < planes; ++overlay_plane) {
            uint overlay_count = counters.counts[(overlay_plane * rows + row) * columns + overlay_column];
            float intensity = trace_intensity(overlay_count, parameters.column_scales[overlay_column]);
            weighted += intensity * parameters.plane_colors[overlay_plane].rgb;
            brightest = max(brightest, intensity);
        }
        float peak = max(weighted.r, max(weighted.g, weighted.b));
        if (brightest > 0.0 && peak > 0.0) {
            branch_trace_color = weighted / peak;
            trace_alpha = brightest * parameters.trace.y;
        }
    } else if (parameters.trace.w == PAINT_COLOR_BY_POSITION) {
        if (count != 0u) {
            trace_alpha = trace_intensity(count, 1.0) * parameters.trace.y;
            branch_trace_color = position_color(column, row);
        }
    } else if (count != 0u) {
        float intensity = min(log2(1.0 + float(count) * parameters.column_scales[column]) / parameters.trace.x, 1.0);
        trace_alpha = intensity * parameters.trace.y;
    }

    vec2 point = vec2(pixel) + vec2(0.5);
    float coverage = 0.0;
    for (uint kept = 0u; kept < kept_count; ++kept) {
        coverage = max(coverage, primitive_coverage(parameters.primitives[kept_primitive_index[kept]], point, picture_px));
    }
    float grid_alpha = coverage * parameters.trace.z;

    // Сетка рисуется ПОД следом: прямая альфа «over».
    float alpha = trace_alpha + grid_alpha * (1.0 - trace_alpha);
    vec4 result = vec4(0.0);
    if (alpha > 0.0) {
        vec3 trace_color = parameters.trace.w == PAINT_PLANE_SECTIONS ? parameters.plane_colors[plane].rgb : branch_trace_color;
        vec3 grid_color = parameters.graticule_color.rgb;
        vec3 color = (trace_color * trace_alpha + grid_color * grid_alpha * (1.0 - trace_alpha)) / alpha;
        result = vec4(color, alpha);
    }
    imageStore(picture, ivec2(pixel), result);
}
