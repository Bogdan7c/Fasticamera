#version 450
#extension GL_GOOGLE_include_directive : require
// Захват снимка из RAW10: кадр — упакованный буфер, 4 пикселя в 5 байтах (формат Android RAW10):
// пиксель i (0..3) группы = (byte_i << 2) | ((byte_4 >> (2*i)) & 3). Шаг строки — в push-константах.

layout(set = 0, binding = 0, std430) readonly buffer PackedFrame {
    uint words[];
} packed_frame;

// Один байт буфера (little-endian внутри слова).
uint byte_at(uint byte_offset) {
    return (packed_frame.words[byte_offset >> 2u] >> ((byte_offset & 3u) * 8u)) & 0xFFu;
}

// Шаг строки лежит в push-константах, которые объявляет включаемый файл; чтобы не дублировать блок,
// отсчёт читает через прототип, тело — ниже включения.
uint raw_at(uint frame_x, uint frame_y);

#include "photo_capture_main.glsl"

uint raw_at(uint frame_x, uint frame_y) {
    uint group_offset = frame_y * capture.row_stride_bytes + (frame_x >> 2u) * 5u;
    uint index_in_group = frame_x & 3u;
    uint high_bits = byte_at(group_offset + index_in_group) << 2u;
    uint low_bits = (byte_at(group_offset + 4u) >> (2u * index_in_group)) & 3u;
    return high_bits | low_bits;
}
