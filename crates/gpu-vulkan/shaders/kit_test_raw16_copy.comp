#version 450
#extension GL_EXT_samplerless_texture_functions : require
// Тест compute-набора (сессия 07): RAW16-кадр как sampled `R16_UINT` (texelFetch, как у камеры) →
// значения в storage-буфер. Доказывает, что MosaicSource привязывается к compute-набору и читается.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform utexture2D raw_frame;
layout(set = 0, binding = 1, std430) buffer CopiedValues {
    uint values[];
} copied;
layout(push_constant) uniform FrameSize {
    uint width;
    uint height;
} frame_size;

void main() {
    uvec2 position = gl_GlobalInvocationID.xy;
    if (position.x >= frame_size.width || position.y >= frame_size.height) {
        return;
    }
    copied.values[position.y * frame_size.width + position.x] = texelFetch(raw_frame, ivec2(position), 0).r;
}
